{
  // Must exactly match the existing Worker's name in the Cloudflare
  // dashboard ("old-night-b2a3") — Workers Builds fails otherwise.
  "name": "old-night-b2a3",
  "compatibility_date": "2026-08-19",
  // The site was pure static assets until /data/ needed gating against bulk
  // scraping. This script runs first on every request, waves everything
  // through to the assets binding below, and only makes a decision about
  // /data/ — see src/index.js.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    // Named so the script can hand a request back to static-asset serving.
    "binding": "ASSETS",
    // Static assets are normally served straight from the edge without the
    // script running at all, which is what you want for the css, the images
    // and the page itself — and which silently meant the /data/ gate was
    // never consulted on a GET. These paths go to the script first; it
    // decides, then hands them back to the assets binding.
    // Both jobs the script does need it to run before asset serving. /data/ so
    // the gate is consulted at all, and the view routes because no file exists
    // at /model/BNR34 — without this Cloudflare 404s them before the script
    // ever sees the request. Everything else still comes straight off the edge.
    // "/" is here because the homepage is the one page whose markup depends on
    // which domain asked for it — bpzilla.com and gtr-registry.org share this
    // document and differ only in the wordmark, which the script swaps.
    //
    // It does not appear to take effect. `wrangler dev` serves "/" from the
    // asset store no matter what is listed here — "/", "/index.html" and a
    // "/*" with negative exclusions were all tried, and the response still
    // comes back with the asset store's own cache header rather than the
    // script's. The documentation says a bare "/" matches, so this may be a
    // local-dev limitation that behaves correctly once deployed; it is left in
    // because it is right if it works and harmless if it does not. What
    // actually guarantees the wordmark on the homepage is the small inline
    // script next to the badge in index.html. Worth re-testing on the live
    // domain: if the edge does swap it, that script never has anything to do.
    "run_worker_first": [
      "/",
      "/data/*",
      "/model/*",
      "/chassis/*",
      "/stats",
      "/decoder",
      "/history",
      "/tools",
      "/legends"
    ],
    // Without this an unknown path returns a zero-byte 404 with no markup at
    // all — a blank white page. Serves public/404.html instead. Deliberately
    // NOT "single-page-application": that would answer every unknown path
    // with index.html and a 200, which would tell search engines that every
    // typo'd URL is a real page.
    "not_found_handling": "404-page"
  },
  // Per-IP rate limiting for /data/, enforced in the script. This is the half
  // of the anti-scraping story that header checks can't cover: a spoofed
  // header defeats the same-origin gate, but it doesn't help against a limit
  // counted per address.
  //
  // 300 requests/minute is deliberately far above real use — a visitor pulls
  // 34 files once per page load, so this allows roughly eight full reloads a
  // minute before anything happens. A scraper walking the archive repeatedly
  // is the only thing that reaches it.
  "unsafe": {
    "bindings": [
      {
        "name": "DATA_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 300, "period": 60 }
      }
    ]
  }
}
