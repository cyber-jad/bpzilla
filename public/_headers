# Cloudflare Pages header rules.
#
# The factory data never changes once deployed — it is a snapshot of the FAST
# microfiche — so it can be cached hard. Everything else gets a short cache so
# a redeploy shows up straight away.

/data/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
