# Cloudflare static-asset header rules.
#
# The factory records themselves are a fixed snapshot of the FAST microfiche,
# so /data/ is cached long. Not `immutable` with a one-year max-age any more,
# though: that was written when /data/ held only the record files, and it has
# since gained derived files that DO get corrected as decoding improves
# (paint.json, factoryOptions.json). A returning visitor would have been stuck
# with a stale copy for up to a year, with no way to bust it short of renaming
# the file — a Cloudflare cache purge doesn't reach a browser cache. One day
# keeps repeat visits fast while letting a correction actually land.

/data/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=2592000

# The markup and the code behind it have to move together. index.html is
# revalidated on every visit (max-age=0) and the worker's routes hold for five
# minutes, but these were held for an hour — so for up to an hour after a
# deploy a returning visitor ran new markup against an old script. That is not
# theoretical: it shipped a chassis lookup whose box rendered and whose button
# did nothing, because the HTML carrying it arrived an hour before the function
# that binds it.
#
# stale-while-revalidate made that cheap but could not close it. Two rules that
# disagree by design still disagree: the M35 removal went live and the site kept
# reporting the old record count, with the dropped chassis still listed, until
# the second page load.
#
# What closes it is version_assets.js, which stamps every reference here with a
# hash of the file's own contents — /js/app.js?v=1f4c2a9b. index.html is always
# fresh, so fresh markup asks for a URL no cache has ever seen and the pair
# cannot disagree. That is the build-step-free version of hashed filenames.
#
# These rules stay as they are rather than going long-and-immutable, which
# stamped URLs would otherwise allow. The stamp is only correct if the script
# was actually run before committing; if it was forgotten, a short max-age
# means the change still lands on its own within the week, while `immutable`
# would pin the stale file for as long as the max-age says. Cheap insurance
# against the one way this can go wrong.
/css/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here is meant to be embedded in someone else's page, and the site
  # has no login or form to clickjack into — DENY costs nothing.
  X-Frame-Options: DENY
  # None of these are used by the site, so they're switched off rather than
  # left available to anything that ends up running on the page.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # One year, but deliberately without includeSubDomains or preload: www does
  # not resolve yet, and both of those are painful to walk back once a browser
  # has cached them. Note this only protects visitors who have already reached
  # the site over HTTPS once — the plain-HTTP entry point still needs
  # "Always Use HTTPS" turned on in the Cloudflare dashboard.
  Strict-Transport-Security: max-age=31536000
  # Content-Security-Policy.
  #
  # This used to say a CSP was not worth having, on the grounds that inline
  # styles force 'unsafe-inline' anyway and a wrong policy silently breaks the
  # charts. Both halves are true and neither is a reason to have no policy.
  #
  # What this actually buys, even with 'unsafe-inline' on scripts: the page
  # loads 627 KB of third-party JavaScript — Lucide from unpkg, Chart.js from
  # jsDelivr — and without a policy, anything that gets a <script src> onto the
  # page can pull code from ANY origin. This names the only two that are
  # allowed. It does not stop a compromise of unpkg itself; nothing here can,
  # short of self-hosting. It stops the page being told to load from a
  # third place.
  #
  # 'unsafe-inline' is required twice and for different reasons: 109 inline
  # style attributes in index.html, and one inline <script> — the wordmark swap
  # beside the badge, which has to run before first paint and so cannot be
  # moved to a file. Neither can be dropped without changing the page.
  #
  # Every origin below was enumerated from the source rather than guessed:
  #   unpkg.com, cdn.jsdelivr.net   the two <script src> tags in index.html
  #   fonts.googleapis.com          @import at the top of css/style.css
  #   fonts.gstatic.com             the font files that @import pulls in
  # schema.org appears in the JSON-LD but is an identifier, never fetched, so
  # it needs no entry. No eval or new Function anywhere in the site's own JS,
  # so 'unsafe-eval' is deliberately absent — Chart.js and Lucide both run
  # without it.
  #
  # static.cloudflareinsights.com is the exception to "enumerated from the
  # source": it is not in the source. Cloudflare Web Analytics injects
  # beacon.min.js into the response itself, downstream of anything in this
  # repo, so the only evidence it exists is the browser console refusing it —
  # which is exactly what happened, silently, for as long as the policy has
  # been live. Analytics on the new domain recorded nothing at all.
  # cloudflareinsights.com (no subdomain) is where the beacon POSTs its
  # measurements, so connect-src needs it too; allowing the script without the
  # endpoint loads the beacon and still discards every result.
  #
  # frame-ancestors duplicates X-Frame-Options for browsers that honour the
  # newer directive; object-src and base-uri close the two gaps that
  # 'unsafe-inline' would otherwise leave worth exploiting.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
